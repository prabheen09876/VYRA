{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vyra",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [
    { "name": "MATCHES", "class_name": "MatchRoom" },
    { "name": "PROFILES", "class_name": "ProfileCoordinator" },
    { "name": "MATCHMAKING", "class_name": "Matchmaking" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom", "ProfileCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaking"] }
  ],
  // REQUIRED BEFORE A REAL DEPLOY: this is a placeholder ID. Run `wrangler d1 create vyra`
  // and paste the returned database_id here. `wrangler deploy` will fail against this value.
  "d1_databases": [{ "binding": "DB", "database_name": "vyra", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ai": { "binding": "AI", "remote": false },
  // REQUIRED BEFORE A REAL DEPLOY: these are local dev origins only. Replace CORS_ORIGINS with
  // the exact deployed web/preview origin(s) that should be allowed to call this API — no
  // wildcards. Flip AI_ENABLED to "true" only after confirming Workers AI quota is available.
  // 8081 is `expo start --web`'s default; 8082 is the port .claude/launch.json pins the web preview
  // to; 5173 is the capture app's Vite dev server; 19006 is the legacy Expo web port. Keep this list
  // in step with wrangler.local.jsonc, which is what `npm run dev:worker` actually loads.
  "vars": { "AI_ENABLED": "false", "CORS_ORIGINS": "http://localhost:8081,http://localhost:8082,http://localhost:19006,http://localhost:5173" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
