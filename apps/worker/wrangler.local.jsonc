{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vyra",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [
    { "name": "MATCHES", "class_name": "MatchRoom" },
    { "name": "PROFILES", "class_name": "ProfileCoordinator" },
    { "name": "MATCHMAKING", "class_name": "Matchmaking" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom", "ProfileCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaking"] }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "vyra", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  // Identical to wrangler.jsonc on purpose. These limits are behaviour the worker depends on rather
  // than environment separation, and the binding has to exist here too or every request throws on a
  // missing `env.IP_LIMITER`. Sized in src/rate-limit.ts; `period` only accepts 10 or 60.
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "GUEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "PLAYER_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  // Local dev origins only — this file is never deployed. 8081 is `expo start --web`'s default; 8082
  // is the port .claude/launch.json pins the web preview to, and without it the previewed app cannot
  // reach this API at all; 5173 is the capture app's Vite dev server; 19006 is the legacy Expo web port.
  //
  // The LAN entry is listed explicitly because 172.32.x.x sits outside RFC 1918 (private is
  // 172.16–172.31), so `isAllowedOrigin`'s private-network clause in src/http.ts does not cover it —
  // replace it when this machine's address changes. The worker's own origin needs no entry: same-origin
  // is allowed before this list is consulted, which is what serves /capture/ from the worker itself.
  "vars": { "AI_ENABLED": "false", "CORS_ORIGINS": "http://localhost:8081,http://localhost:8082,http://localhost:19006,http://localhost:5173,http://172.32.2.227:8082" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
