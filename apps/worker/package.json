{
  "name": "@vyra/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply vyra --config wrangler.local.jsonc --local"
  },
  "dependencies": { "@vyra/core": "0.1.0" },
  "devDependencies": { "wrangler": "4.131.1", "@cloudflare/workers-types": "5.20260911.1" }
}
