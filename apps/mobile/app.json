{
  "expo": {
    "name": "VYRA",
    "slug": "vyra",
    "version": "0.1.0",
    "scheme": "vyra",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070A",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vyra.fitness",
      "infoPlist": {
        "NSCameraUsageDescription": "VYRA uses your camera to count exercise repetitions on your device."
      }
    },
    "android": {
      "package": "app.vyra.fitness",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#05070A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "VYRA",
      "themeColor": "#05070A",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", {
        "cameraPermission": "Let VYRA count exercise repetitions using your camera. Video stays on your device.",
        "recordAudioAndroid": false
      }]
    ]
  }
}
